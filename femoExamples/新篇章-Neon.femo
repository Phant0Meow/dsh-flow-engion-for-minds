meta:
  name = 新篇章-Neon
  version = 1.0
  owner = 1
  database = chronica.wor
  session = new

action 提文案 @human:
  prompt: |
    请告诉AI你要做的视频的文案提纲、要求、各种信息。
    你也可以直接提供定稿的文案。
  out:
    textPass

action 写文案 @ai:
  prompt: |
    请写视频文案

action 生成配音 @ai:

action 审配音 @human:
  prompt: |
    请核查配音是否过关。
    有修改意见直接提。
    如果没问题，请输出voicePass = true
  out:
    voicePass

action 生成设计稿 @ai:
  prompt: |
    请给每句文案设计视频画面。
    你需要根据每句配音的时长，以下面的格式生成：

action 审设计稿 @human:
  prompt: |
    可以和AI讨论。
    确认没问题准备进行下一步时，请输出designPass = true
  out:
    designPass

action 生成图 @ai:

action 图片落实 @human:
  prompt: |
    检查AI生成的图片，注意检查是否有重叠，下方字幕区是否可能有遮挡。
    同时你也要提供需要你准备的那些素材图或视频。
    建议把素材文件名起好，方便AI认出来这是他要的哪张图。（不然他又得费事儿去识图或者读关键帧，烧的是你的token。）
    
    最终所有素材确定时，请输出picPass = true
  out:
    picPass

action 调整至定稿 @human:
  prompt: |
    和AI讨论最后的细节处理。
    如果确认定稿，请输出yes = true
  out:
    yes

action 调整设计稿 @ai:
  prompt: |
    根据最终实际得到的图片、视频素材，你看看设计稿有什么地方需要调整？
    尤其是，如果有视频素材，你需要看素材时长是否和你的设计稿留的空位置合适。
    如果时长不匹配，你需要考虑素材是否可以裁切、是否可以加速、是否可以关键帧延时。请告诉用户时间是具体如何不匹配，并征求用户的同意。

action 开剪！ @ai:
  prompt: |
    请根据设计稿，开始剪视频！

mainflow:
  [提文案]: 提文案
  [写文案]: 写文案
  [生成配音]: 生成配音
  [审配音]: 审配音
  [生成设计稿]: 生成设计稿
  [审设计稿]: 审设计稿
  [生成图]: 生成图
  [图片落实]: 图片落实
  [调整至定稿]: 调整至定稿
  [调整设计稿]: 调整设计稿
  [开剪！_2]: 开剪！

  [START] -> [提文案]
  [提文案] -> fork:
    -> if (textPass != true) -> [写文案]
    -> if (textPass==true) -> [生成配音]
  [写文案] -> [提文案]
  [生成配音] -> [审配音]
  [审配音] -> fork:
    -> if (voicePass != true) -> [生成配音]
    -> if (voicePass==true) -> [生成设计稿]
  [生成设计稿] -> [审设计稿]
  [审设计稿] -> fork:
    -> if (designPass != true) -> [生成设计稿]
    -> if (designPass == true) -> [生成图]
  [生成图] -> [图片落实]
  [图片落实] -> fork:
    -> if (picPass != true) -> [生成图]
    -> if (picPass==true) -> [调整设计稿]
  [调整设计稿] -> [调整至定稿]
  [调整至定稿] -> fork:
    -> if (yes != true) -> [调整设计稿]
    -> if (yes==true) -> [开剪！_2]

#sketch:
#  [END] = 856, 209
#  [提文案] = -6, 91
#  [写文案] = -6, 199
#  [生成配音] = 148, 92
#  [审配音] = 148, 197
#  [生成设计稿] = 302, 197
#  [审设计稿] = 303, 94
#  [生成图] = 460, 95
