meta:
  name = 工具调用测试
  session = new

actors:
  # 权限测试：这个角色只被授予 read 工具（白名单），没有写/编辑工具
  ai @reader = soul:the1stlittlesoul, tools: ["read"]

action read_file @ai(@reader):
  prompt: |
    你的任务：使用 read 工具读取文件 D:/myFiles/dsh/dsh-femo/femoExamples/werewolf_utils.py 的内容，
    然后用一两句话汇报这个文件是干什么的（读出内容后总结即可，不要输出流程元信息）。
    记住：你必须实际调用 read 工具来读取文件，不能凭空猜测文件内容。
  scope: [@reader]

mainflow:
  [START] -> read_file -> [END]
