meta:
  name = AI剪视频
  version = 1.0
  session = new

actors:
  ai @剪辑师
  human @用户

vars:
  textPass = false
  voicePass = false
  designPass = false
  picPass = false
  yes = false

action 提文案 @human(@用户):
  prompt: |
    请告诉AI你要做的视频的文案提纲、要求、各种信息，让他写文案。
    你也可以直接提供定稿的文案。
    如果AI写的你不满意，你可以提意见让他修改，或者自己也参与写作。
    当你确定文案已定稿时，请输出：SET VARIABLE: <<textPass = true>>
    注意：后续所有工作都基于文案，强烈建议这一步用心打磨，后面就别改了。因为后面再改文案会很麻烦。
  scope: all
  out:
    textPass(bool, "文案是否定稿")

action 写文案 @ai(@剪辑师):
  prompt: |
    请根据人类给出的文案提纲和要求，写出完整的视频文案。
    逐句编号，方便后续逐句配音、逐句配画面。
    只干这一件事，写完文案就停。
  scope: all

action 生成配音 @ai(@剪辑师):
  prompt: |
    请把定稿文案逐句生成配音音频（用你手上可用的工具，比如 TTS 命令行/脚本）。
    要求：
    1. 每句一个音频文件，存到工作目录的 voice/ 文件夹，按序号命名（如 01.mp3）。
    2. 完成后在对话里逐句报告清单：序号 | 文案原文 | 音频文件名 | 实际时长（精确到0.1秒）。
    这份时长清单是下一步设计画面的依据，务必准确。
    只干这一件事，做完就停，不要进行下一步。
  scope: all

action 审配音 @human(@用户):
  prompt: |
    请核查配音是否过关。
    注意英文、数字、特殊专有名词等配音是否正确，别忘了审核语速快慢。
    有修改意见直接提。
    如果没问题，请输出：SET VARIABLE: <<voicePass = true>>
  scope: all
  out:
    voicePass(bool, "配音是否过关")

action 生成设计稿 @ai(@剪辑师):
  prompt: |
    请给每句文案设计视频画面。
    你需要根据每句配音的时长，以下面的格式逐句生成：
    ## [时间起 - 时间止] 文案原文（文案本句起止时间必须由实际生成的配音音频文件计算得出）
    - [时间起 - 时间止]：图或视频素材名
    需求：可写素材内容、素材风格等，你认为这里应该放什么样的素材。
    来源：AI自己画图
    - [时间起 - 时间止]：图或视频素材名2
    需求：同一句视频文案的时间内，可以有多个视觉素材，你需要把时间轴安排好。
    来源：用户提供
    - [时间起 - 时间止]：图或视频素材名3 + 图或视频素材名4
    需求：同屏可以有多个素材，比如分左右，在需求中写清：左边素材3，右边素材4.
    来源：素材3-AI自己画图，素材4-用户提供
    ## [时间起 - 时间止] 下一句文案原文（就这样一直把配音的每一句都列举，并把图设计好）
    设计稿需要用户审核，用户觉得没问题才可以进行下一步。用户觉得有问题你要改，改完还需要用户审核。
  scope: all

action 审设计稿 @human(@用户):
  prompt: |
    可以和AI讨论。
    确认没问题准备进行下一步时，请输出：SET VARIABLE: <<designPass = true>>
  scope: all
  out:
    designPass(bool, "设计稿是否定稿")

action 生成图 @ai(@剪辑师):
  prompt: |
    请按定稿设计稿，把其中标注「来源：AI自己画图」的素材逐个生成出来。
    要求：
    1. 文件存到 assets/ 文件夹，文件名用设计稿里写的素材名。
    2. 「来源：用户提供」的素材不用你生成，等用户给。
    3. 生成后在对话里报告：文件名 ↔ 对应设计稿哪一条。
  scope: all

action 图片落实 @human(@用户):
  prompt: |
    检查AI生成的图片，注意检查是否有重叠，下方字幕区是否可能有遮挡。
    同时你也要提供需要你准备的那些素材图或视频。
    建议把素材文件名起好，方便AI认出来这是他要的哪张图。（不然他又得费事儿去识图或者读关键帧，烧的是你的token。）
    最终所有素材确定时，请输出：SET VARIABLE: <<picPass = true>>
  scope: all
  out:
    picPass(bool, "素材是否齐了")

action 调整设计稿 @ai(@剪辑师):
  prompt: |
    根据最终实际得到的图片、视频素材，你看看设计稿有什么地方需要调整？
    尤其是，如果有视频素材，你需要看素材时长是否和你的设计稿留的空位置合适。
    如果时长不匹配，你需要考虑素材是否可以裁切、是否可以加速、是否可以关键帧延时。请告诉用户时间是具体如何不匹配，并征求用户的同意。
    设计稿需要用户审核，用户觉得没问题才可以进行下一步。用户觉得有问题你要改，改完还需要用户审核。
  scope: all

action 调整至定稿 @human(@用户):
  prompt: |
    和AI讨论最后的细节处理。
    如果确认定稿，请输出：SET VARIABLE: <<yes = true>>
  scope: all
  out:
    yes(bool, "是否定稿开剪")

action 开剪 @ai(@剪辑师):
  prompt: |
    用户通过了你的方案！请根据设计稿，开始剪视频！
    用你手上可用的工具（比如 ffmpeg 命令行），把配音、素材按设计稿拼装成片。
    注意时间轴不能错。别忘了加字幕。
    剪完抽帧检查是否符合预期，检查时间轴是否符合预期、字幕、图片素材是否显示等。
    如果有问题就修。
    如果检查没问题，报告成片文件路径。
  scope: all

action 兜底讨论 @human(@用户):
  prompt: |
    看看视频，还有问题吗？
    有问题再提，此节点无限循环，你可以一直在这里和AI交谈。
    如果没问题了，你可以手动结束流程~

action 再修 @ai(@剪辑师):
  prompt: |
    请根据用户的修改意见，继续修改，直至最终完成。

mainflow:
  [提文案]: 提文案
  [写文案]: 写文案
  [生成配音]: 生成配音
  [审配音]: 审配音
  [生成设计稿]: 生成设计稿
  [审设计稿]: 审设计稿
  [生成图]: 生成图
  [图片落实]: 图片落实
  [调整至定稿]: 调整至定稿
  [调整设计稿]: 调整设计稿
  [开剪]: 开剪
  [兜底讨论]: 兜底讨论
  [再修]: 再修
  [再修_2]: 再修

  [START] -> [提文案]
  [提文案] -> fork:
    -> if (textPass != true) -> [写文案]
    -> if (textPass==true) -> [生成配音]
  [写文案] -> [提文案]
  [生成配音] -> [审配音]
  [审配音] -> fork:
    -> if (voicePass != true) -> [生成配音]
    -> if (voicePass==true) -> [生成设计稿]
  [生成设计稿] -> [审设计稿]
  [审设计稿] -> fork:
    -> if (designPass != true) -> [生成设计稿]
    -> if (designPass == true) -> [生成图]
  [生成图] -> [图片落实]
  [图片落实] -> fork:
    -> if (picPass != true) -> [生成图]
    -> if (picPass==true) -> [调整设计稿]
  [调整设计稿] -> [调整至定稿]
  [调整至定稿] -> fork:
    -> if (yes != true) -> [调整设计稿]
    -> if (yes==true) -> [开剪]
  [开剪] -> [兜底讨论]
  [兜底讨论] -> [再修_2]
  [再修_2] -> [兜底讨论]

#sketch:
