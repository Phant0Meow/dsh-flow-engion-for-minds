meta:
  name = 语法测试2-顺序循环
  session = new

vars:
  @m = ""
  members = [@eve, @cat]
  alive = {@eve: true, @cat: false}
  count = 0

actors:
  ai @eve = soul:the1stlittlesoul
  ai @cat = soul:littlecat

action count_up @assign:
  out:
    count += 1

mainflow:
  [START] -> [B] -> for @m in members:
    -> if (alive.@m == true) -> [C]:count_up ->
  -> [END]
