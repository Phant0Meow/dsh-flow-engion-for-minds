module chat:
  vars:
    @player = ""

  action chat @mind(@player):
    prompt: |
      游戏结束啦，随便聊聊吧～
    scope: all

  action chat_human @human(@人):
    scope: all

  flow:
    [chat]: chat
    [hub]: 
    [AI_line]: 
    [pos_1]: 
    [chat_human]: chat_human

    [IN] -> [hub]
    [hub] -> fork:
      -> [AI_line]
      -> [pos_1]
    [AI_line] -> for @player in [@Eve, @小猫咪, @小机, @小灵, @Portia, @AI助手]:
      -> [chat] ->
    -> [OUT]
    [pos_1] -> [chat_human]
    [chat_human] -> [pos_1]

#  sketch:
#    [FOR] = -207, 236
#    [OUT] = 7, 289
#    [chat] = -129, 175
#    [hub] = -1, 91
#    [AI_line] = -210, 129
#    [pos_1] = 187, 124
#    [chat_human] = 180, 209

mainflow:
  [roleCard]: roleCard
  [game_loop]: &NightPhase
  [day]: &DayPhase
  [chat]: &chat

  [START] -> [roleCard]
  [roleCard] -> [game_loop]
  [game_loop] -> [day]
  [day] -> fork:
    -> if (game_over == false) -> [game_loop]
    -> if (game_over == true) -> [chat]
  [chat] -> [END]

