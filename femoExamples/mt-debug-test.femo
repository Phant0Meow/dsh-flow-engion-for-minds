meta:
  name = multi-tool-test
  version = 1.0
  owner = 001
  session = new

actors:
  ai @alana = soul:debugmanager, tools: [read, write, edit, glob, grep]
  ai @coder1 = soul:debugcoder1, tools: false
  ai @coder2 = soul:debugcoder2, tools: false

vars:
  all = [@alana, @coder1, @coder2]

action 读文件 @ai(@alana):
  prompt: |
    你是调试负责人 alana，你有工具。
    请用 read 工具分别读取以下两个文件（必须分两次 read 调用，一次读一个）：
    1. D:/myFiles/dsh/dsh-femo/python/mt_test/file_a.py
    2. D:/myFiles/dsh/dsh-femo/python/mt_test/file_b.py
    两个都读完后，用文字总结：每个文件的函数名、功能，以及 file_a.py 里你发现的 bug。
    注意：一定要真的调用 read 工具两次，不要凭想象。
  scope: all

action 方案一 @ai(@coder1):
  prompt: |
    你是程序员 coder1。你没有工具，不能读文件、不能改文件，只能用文字说话。
    基于对话历史中 alana 总结的两个文件内容，用文字给出 file_a.py 的修改方案：改成什么样、为什么。
    只输出文字方案，绝对不要调用任何工具。
  scope: all

action 方案二 @ai(@coder2):
  prompt: |
    你是程序员 coder2。你没有工具，不能读文件、不能改文件，只能用文字说话。
    基于对话历史中 alana 总结的两个文件内容，独立给出 file_a.py 的修改方案，可以同意 coder1 也可以提出不同意见，说出理由。
    只输出文字方案，绝对不要调用任何工具。
  scope: all

action 动手改 @ai(@alana):
  prompt: |
    你是调试负责人 alana，你有工具。
    两个程序员给出了方案。现在请你：
    1. 先用 read 工具读一次 D:/myFiles/dsh/dsh-femo/python/mt_test/file_a.py 确认当前内容；
    2. 再用 edit 工具把 bug 修掉（参考两个程序员的方案）；
    3. 修改完成后，用文字汇报：改了哪个文件、具体改了什么、你一共调用了哪几个工具（列出每次调用的工具名）。
  scope: all

mainflow:
  [读文件]: 读文件
  [方案一]: 方案一
  [方案二]: 方案二
  [动手改]: 动手改

  [START] -> [读文件]
  [读文件] -> [方案一]
  [方案一] -> [方案二]
  [方案二] -> [动手改]
  [动手改] -> [END]
